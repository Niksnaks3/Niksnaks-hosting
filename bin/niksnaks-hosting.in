#!/usr/bin/env @PYTHON@
import os
import sys
import signal
from pathlib import Path

# Set up data directory as the old wrapper did
xdg_data_home = os.environ.get("XDG_DATA_HOME")
if not xdg_data_home:
    xdg_data_home = os.path.join(os.path.expanduser("~"), ".local", "share")

niksnaks_hosting_data_dir = os.environ.get("NIKSNAKS_HOSTING_DATA_DIR")
if not niksnaks_hosting_data_dir:
    niksnaks_hosting_data_dir = os.path.join(xdg_data_home, "niksnaks-hosting")

os.environ["NIKSNAKS_HOSTING_DATA_DIR"] = niksnaks_hosting_data_dir

# Create the data dir if it does not exist
try:
    os.makedirs(niksnaks_hosting_data_dir, exist_ok=True)
except Exception as e:
    print(f"Warning: Could not create data directory {niksnaks_hosting_data_dir}: {e}", file=sys.stderr)

# Set up the path to find the niksnaks_hosting package
pkgdatadir = '@pkgdatadir@'
if os.path.exists(pkgdatadir):
    sys.path.insert(0, pkgdatadir)

from niksnaks_hosting.factory import create_application

def main():
    """Launch the Niksnaks-Hosting application."""
    try:
        app = create_application()
        return app.run(sys.argv)
    except KeyboardInterrupt:
        return 130
    except NotImplementedError as exc:
        print(f"Niksnaks-Hosting startup error: {exc}", file=sys.stderr)
        return 2
    except Exception as exc:
        print(f"Niksnaks-Hosting startup error: {exc}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    # Handle SIGINT (Ctrl+C) gracefully
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(main())
